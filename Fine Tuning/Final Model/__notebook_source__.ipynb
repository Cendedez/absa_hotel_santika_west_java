def targets(df):
    Y = np.zeros((len(df), len(ASPECTS)), dtype=np.int64)
    for i, aspect in enumerate(ASPECTS):
        Y[:, i] = df[aspect].map(nlab).map(LABEL2ID).astype(np.int64).values
    return Y


