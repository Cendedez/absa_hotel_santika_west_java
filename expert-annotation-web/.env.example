# Supabase server-side credentials (JANGAN commit nilai asli).
# Set ini di Vercel: Project Settings -> Environment Variables.
#
# Ambil dari Supabase Dashboard (UI baru):
#   - SUPABASE_URL  -> Project Settings -> Data API -> Project URL
#   - SUPABASE_SERVICE_ROLE_KEY -> Project Settings -> API Keys -> Secret keys
#     (nilai diawali sb_secret_...). Boleh juga service_role lama dari tab Legacy.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Catatan:
# - SERVICE_ROLE_KEY hanya dipakai server-side (API routes). Tidak pernah
#   dikirim ke browser. Jangan pakai prefix NEXT_PUBLIC_.
# - Jika kedua variabel ini kosong, aplikasi otomatis jalan dalam "mode lokal"
#   (localStorage saja) tanpa error.
